<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="app.VentanaReportes">
  <grid id="27dc6" binding="panelReportes" layout-manager="GridLayoutManager" row-count="4" column-count="6" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="818" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="585e6" class="javax.swing.JLabel" binding="lblReporte">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="4" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <enabled value="true"/>
          <font name="Fira Code" size="18"/>
          <text value="Reportes"/>
        </properties>
      </component>
      <component id="d6ab6" class="javax.swing.JButton" binding="btnActivos">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font name="Fira Code"/>
          <text value="Préstamos Activos"/>
        </properties>
      </component>
      <component id="fcb2a" class="javax.swing.JButton" binding="btnAtrasados">
        <constraints>
          <grid row="2" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font name="Fira Code"/>
          <text value="Préstamos Atrasados"/>
        </properties>
      </component>
      <component id="1b495" class="javax.swing.JButton" binding="btnMasPrestados">
        <constraints>
          <grid row="2" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font name="Fira Code"/>
          <text value="Libros Más Prestados"/>
        </properties>
      </component>
      <scrollpane id="ecbaf">
        <constraints>
          <grid row="3" column="1" row-span="1" col-span="4" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="5b6e" class="javax.swing.JTable" binding="tablaReportes">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
      <hspacer id="f946a">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="4" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
      </hspacer>
      <vspacer id="eba2c">
        <constraints>
          <grid row="0" column="5" row-span="4" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
        </constraints>
      </vspacer>
      <vspacer id="9a21b">
        <constraints>
          <grid row="0" column="0" row-span="4" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
        </constraints>
      </vspacer>
      <component id="4f92a" class="javax.swing.JButton" binding="btnHistorial">
        <constraints>
          <grid row="2" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font name="Fira Code"/>
          <text value="Historial Estudiante"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
